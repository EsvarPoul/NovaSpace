---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingWidget from "../components/booking/BookingWidget.astro";
import { makeBreadcrumbSchema, makeWebPageSchema, organizationSchema, webSiteSchema } from "../data/seo.js";

const pageTitle = "Бронювання Nova Space Бровари | NOVA VR, PS5 і PhotoStudio";
const pageDescription = "Онлайн-бронювання NOVA VR, PS5, NovaMix, днів народження та Nova PhotoStudio у Броварах. Оберіть формат, дату і зручний слот.";
const bookingPageSchema = makeWebPageSchema({
  path: "/booking/",
  name: pageTitle,
  description: pageDescription
});
const breadcrumbSchema = makeBreadcrumbSchema([
  { name: "Nova Space", url: "/" },
  { name: "Бронювання", url: "/booking/" }
]);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/booking/"
  schema={[organizationSchema, webSiteSchema, bookingPageSchema, breadcrumbSchema]}
>
  <main class="booking-app" data-booking-app>
    <header class="booking-hero">
      <a class="booking-brand" href="/">
        <span>Nova Space</span>
        <small>Booking calendar</small>
      </a>
      <div>
        <span class="booking-kicker">Nova Space booking</span>
        <h1>Оберіть формат і зручний час</h1>
        <p>VR, PS5, день народження або фотостудія. Форма покаже тариф, а менеджер підтвердить деталі.</p>
      </div>
    </header>

    <a class="booking-call-inline" href="tel:+380660097630">
      <span>Потрібна допомога з бронюванням?</span>
      <strong>Дзвінок</strong>
    </a>

    <BookingWidget
      introTitle="Нове бронювання"
      introText="Оберіть формат, дату і слот. Для ДР або фотографа додайте деталі в коментарі."
    />
  </main>
</BaseLayout>
