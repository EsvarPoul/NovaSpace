---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import MobileActionBar from "../components/layout/MobileActionBar.astro";
import { address, bookingUrl, makeBreadcrumbSchema, makeItemListSchema, mapsUrl, novaPhotoStudioSchema, novaVrSchema, organizationSchema, phone, siteUrl, webSiteSchema } from "../data/seo.js";
import { studioLandingPages } from "../data/studioLandingPages.js";
import { getRelatedVrLandingPages, vrLandingPages } from "../data/vrLandingPages.js";

interface VrLandingPage {
  type?: "vr" | "studio";
  slug: string;
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  lead: string;
  image: string;
  imageAlt: string;
  primaryCta: string;
  secondaryCta: string;
  highlights: string[];
  sections: Array<{
    title: string;
    text: string;
  }>;
  stats: Array<{
    label: string;
    value: string;
  }>;
  faq: Array<{
    question: string;
    answer: string;
  }>;
  related?: string[];
}

const landingPagesForRelated = [...(vrLandingPages as VrLandingPage[]), ...(studioLandingPages as VrLandingPage[])];
const getLandingPage = (slug: string) => landingPagesForRelated.find((item) => item.slug === slug);
const getRelatedLandingPages = (page: VrLandingPage) =>
  (page.related || [])
    .map((slug) => getLandingPage(slug))
    .filter(Boolean) as VrLandingPage[];

export function getStaticPaths() {
  return [...(vrLandingPages as VrLandingPage[]), ...(studioLandingPages as VrLandingPage[])].map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props as { page: VrLandingPage };
const isStudioLanding = page.type === "studio";
const relatedPages = isStudioLanding ? getRelatedLandingPages(page) : (getRelatedVrLandingPages(page) as VrLandingPage[]);
const pageUrl = `${siteUrl}/${page.slug}/`;
const addressText = `${address.streetAddress}, ${address.addressLocality}`;
const parentPage = isStudioLanding
  ? { name: "Nova PhotoStudio", url: `${siteUrl}/studio/`, path: "/studio/" }
  : { name: "NOVA VR", url: `${siteUrl}/vr/`, path: "/vr/" };
const businessSchema = isStudioLanding ? novaPhotoStudioSchema : novaVrSchema;
const providerId = `${siteUrl}/${isStudioLanding ? "studio" : "vr"}/#localbusiness`;
const headerNav = isStudioLanding
  ? [
      { label: "Фотостудія", href: "/studio/" },
      { label: "Оренда", href: "/orenda-fotostudiyi-brovary/" },
      { label: "Фотосесія", href: "/fotosesiya-brovary/" },
      { label: "Контакти", href: "#contacts" }
    ]
  : [
      { label: "VR клуб", href: "/vr/" },
      { label: "День народження", href: "/den-narodzhennya-vr-brovary/" },
      { label: "PS5", href: "/ps5-brovary/" },
      { label: "Контакти", href: "#contacts" }
    ];
const schedule = isStudioLanding ? "Щодня|10:00-21:00" : "Щодня|10:00-22:00";
const instagramUrl = isStudioLanding ? "https://www.instagram.com/nova_photostudio_/" : "https://instagram.com/novaspace_vr";
const instagramLabel = isStudioLanding ? "@nova_photostudio_" : "@novaspace_vr";
const contactTitle = isStudioLanding ? "Nova PhotoStudio у Броварах" : "NOVA VR у Броварах";
const contactText = isStudioLanding
  ? `Адреса: ${addressText}. Працюємо щодня з 10:00 до 21:00.`
  : `Адреса: ${addressText}. Працюємо щодня з 10:00 до 22:00.`;
const secondaryCtaHref = isStudioLanding ? parentPage.path : "/vr/#sessions";

const breadcrumbSchema = makeBreadcrumbSchema([
  { name: "Nova Space", url: "/" },
  { name: "Бровари", url: "/brovary/" },
  { name: parentPage.name, url: parentPage.url },
  { name: page.h1, url: pageUrl }
]);

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: page.title,
  description: page.description,
  inLanguage: "uk-UA",
  isPartOf: {
    "@id": `${siteUrl}/#website`
  },
  publisher: {
    "@id": `${siteUrl}/#organization`
  },
  about: {
    "@id": providerId
  },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: `${siteUrl}${page.image}`
  }
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: page.h1,
  description: page.lead,
  provider: {
    "@id": providerId
  },
  areaServed: {
    "@type": "City",
    name: "Бровари"
  },
  serviceType: page.eyebrow,
  potentialAction: {
    "@type": "ReserveAction",
    name: page.primaryCta,
    target: {
      "@type": "EntryPoint",
      urlTemplate: bookingUrl,
      inLanguage: "uk-UA",
      actionPlatform: [
        "http://schema.org/DesktopWebPlatform",
        "http://schema.org/MobileWebPlatform"
      ]
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
const relatedFormatsSchema = relatedPages.length
  ? makeItemListSchema({
      id: `/${page.slug}/#related-formats`,
      name: isStudioLanding
        ? "Схожі формати Nova PhotoStudio у Броварах"
        : "Схожі формати NOVA VR у Броварах",
      items: relatedPages.map((related) => ({
        name: related.eyebrow,
        url: `/${related.slug}/`
      }))
    })
  : null;
const schema = [
  organizationSchema,
  webSiteSchema,
  businessSchema,
  webPageSchema,
  serviceSchema,
  breadcrumbSchema,
  faqSchema,
  ...(relatedFormatsSchema ? [relatedFormatsSchema] : [])
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonicalPath={`/${page.slug}/`}
  image={page.image}
  schema={schema}
>
  <div class={`vr-local-page${isStudioLanding ? " vr-local-page--studio" : ""}`}>
    <Header
      brand="Nova Space"
      sub={parentPage.name}
      nav={headerNav}
      schedule={schedule}
      ctaHref="/booking/"
      ctaLabel="Забронювати"
    />

    <main>
      <section class="vr-local-hero" aria-labelledby="vr-local-title">
        <div class="vr-local-hero__copy">
          <nav class="vr-local-breadcrumbs" aria-label="Навігаційний шлях">
            <a href="/">Nova Space</a>
            <span>/</span>
            <a href="/brovary/">Бровари</a>
            <span>/</span>
            <a href={parentPage.path}>{parentPage.name}</a>
            <span>/</span>
            <strong>{page.eyebrow}</strong>
          </nav>
          <span class="vr-local-kicker">{page.eyebrow}</span>
          <h1 id="vr-local-title">{page.h1}</h1>
          <p>{page.lead}</p>
          <div class="vr-local-actions">
            <a class="vr-local-button vr-local-button--primary" href="/booking/">{page.primaryCta}</a>
            <a class="vr-local-button" href={secondaryCtaHref}>{page.secondaryCta}</a>
          </div>
        </div>
        <figure class="vr-local-hero__media">
          <img src={page.image} alt={page.imageAlt} width="800" height="500" loading="eager" />
          <figcaption>
            <span>Бровари</span>
            <strong>{address.streetAddress}</strong>
          </figcaption>
        </figure>
      </section>

      <section class="vr-local-stats" aria-label="Ключові деталі">
        {page.stats.map((stat) => (
          <article>
            <span>{stat.label}</span>
            <strong>{stat.value}</strong>
          </article>
        ))}
      </section>

      <section class="vr-local-grid" aria-labelledby="vr-local-includes">
        <div>
          <span class="vr-local-kicker">Що важливо знати</span>
          <h2 id="vr-local-includes">Формат під конкретний запит у Броварах</h2>
          <p>
            Тут зібрали головні деталі формату: що входить, кому підходить, як проходить бронювання
            і що варто уточнити перед візитом у NOVA VR.
          </p>
        </div>
        <div class="vr-local-points">
          {page.highlights.map((item) => (
            <article>
              <span></span>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="vr-local-sections" aria-label="Деталі формату">
        {page.sections.map((section) => (
          <article>
            <h2>{section.title}</h2>
            <p>{section.text}</p>
          </article>
        ))}
      </section>

      <section class="vr-local-faq" aria-labelledby="vr-local-faq-title">
        <div>
          <span class="vr-local-kicker">FAQ</span>
          <h2 id="vr-local-faq-title">Питання, які зазвичай уточнюють перед бронюванням</h2>
        </div>
        <div>
          {page.faq.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </section>

      {relatedPages.length > 0 && (
        <section class="vr-local-related" aria-labelledby="vr-local-related-title">
          <div>
            <span class="vr-local-kicker">Інші формати</span>
            <h2 id="vr-local-related-title">Ще кілька варіантів у NOVA VR</h2>
          </div>
          <div class="vr-local-related__grid">
            {relatedPages.map((related) => (
              <a href={`/${related.slug}/`}>
                <span>{related.eyebrow}</span>
                <strong>{related.h1}</strong>
                <em>{related.description}</em>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>

    <footer id="contacts" class="vr-local-contact">
      <div>
        <span class="vr-local-kicker">Контакти</span>
        <h2>{contactTitle}</h2>
        <p>{contactText}</p>
      </div>
      <div class="vr-local-contact__actions">
        <a href={`tel:${phone}`}>+380 66 009 7630</a>
        <a href={mapsUrl} target="_blank" rel="noreferrer">Відкрити маршрут</a>
        <a href={instagramUrl} target="_blank" rel="noreferrer">{instagramLabel}</a>
      </div>
    </footer>
  </div>

  <MobileActionBar
    primaryHref="/booking/"
    primaryLabel="Забронювати"
    secondaryHref="tel:+380660097630"
    secondaryLabel="Дзвінок"
    class={isStudioLanding ? "mobile-action-bar--studio" : "mobile-action-bar--vr"}
  />
</BaseLayout>
