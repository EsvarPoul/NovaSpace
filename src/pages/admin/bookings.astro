---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="NOVA Booking Admin"
  description="Manager calendar for NOVA bookings."
>
  <main class="booking-admin" data-admin-app>
    <header class="booking-admin__top">
      <a class="booking-brand" href="/booking">
        <span>NOVA</span>
        <small>Manager board</small>
      </a>
      <div class="booking-admin__auth" data-auth-panel>
        <input type="email" placeholder="manager@email.com" autocomplete="email" data-login-email />
        <input type="password" placeholder="Пароль" autocomplete="current-password" data-login-password />
        <button type="button" data-login-button>Увійти</button>
        <button type="button" data-logout-button hidden>Вийти</button>
      </div>
    </header>

    <section class="booking-admin__controls">
      <label class="booking-field">
        <span>Період від</span>
        <input type="date" data-board-from />
      </label>
      <label class="booking-field">
        <span>Період до</span>
        <input type="date" data-board-to />
      </label>
      <button class="booking-submit" type="button" data-load-board>Оновити календар</button>
    </section>

    <section class="booking-admin__layout">
      <div class="booking-panel">
        <div class="booking-panel__head">
          <span>Calendar</span>
          <h1>Бронювання</h1>
        </div>
        <div class="booking-board" data-booking-board>
          <p>Увійдіть менеджером, щоб побачити бронювання.</p>
        </div>
      </div>

      <aside class="booking-panel">
        <div class="booking-panel__head">
          <span>Manual block</span>
          <h2>Заблокувати час</h2>
        </div>
        <form class="booking-block-form" data-block-form>
          <label class="booking-field">
            <span>Resource slug або порожньо для всіх</span>
            <input name="resource_slug" placeholder="vr-room" />
          </label>
          <label class="booking-field">
            <span>Початок</span>
            <input name="starts_at" type="datetime-local" required />
          </label>
          <label class="booking-field">
            <span>Кінець</span>
            <input name="ends_at" type="datetime-local" required />
          </label>
          <label class="booking-field">
            <span>Причина</span>
            <input name="reason" placeholder="Private event, repair, lunch" />
          </label>
          <button class="booking-submit" type="submit">Додати блокування</button>
        </form>
        <p class="booking-status" data-admin-status role="status"></p>
      </aside>
    </section>
  </main>
</BaseLayout>

<script>
  import { isSupabaseConfigured, supabase } from "../../lib/supabaseClient";

  interface BoardBooking {
    id: string;
    service_name: string;
    service_slug: string;
    area: string;
    customer_name: string;
    customer_phone: string;
    customer_email?: string;
    party_size: number;
    start_at: string;
    end_at: string;
    status: string;
    comment?: string;
    manager_note?: string;
    resource_names: string[];
  }

  const emailInput = document.querySelector<HTMLInputElement>("[data-login-email]");
  const passwordInput = document.querySelector<HTMLInputElement>("[data-login-password]");
  const loginButton = document.querySelector<HTMLButtonElement>("[data-login-button]");
  const logoutButton = document.querySelector<HTMLButtonElement>("[data-logout-button]");
  const fromInput = document.querySelector<HTMLInputElement>("[data-board-from]");
  const toInput = document.querySelector<HTMLInputElement>("[data-board-to]");
  const loadButton = document.querySelector<HTMLButtonElement>("[data-load-board]");
  const board = document.querySelector<HTMLElement>("[data-booking-board]");
  const blockForm = document.querySelector<HTMLFormElement>("[data-block-form]");
  const status = document.querySelector<HTMLElement>("[data-admin-status]");

  const setStatus = (message: string, state = "idle") => {
    if (!status) return;
    status.textContent = message;
    status.dataset.state = state;
  };

  const formatAuthError = (message: string) => {
    const normalized = message.toLowerCase();
    if (normalized.includes("invalid login credentials")) return "Невірний email або пароль.";
    if (normalized.includes("email not confirmed")) return "Email менеджера ще не підтверджено в Supabase Auth.";
    return message;
  };

  const formatAdminError = (message: string) => (
    message.includes("Manager access required")
      ? "Користувач увійшов, але його UUID не додано в public.manager_users."
      : message
  );

  const toDateInput = (date: Date) => {
    const local = new Date(date);
    local.setMinutes(local.getMinutes() - local.getTimezoneOffset());
    return local.toISOString().slice(0, 10);
  };

  const toKyivRange = (dateValue: string, endOfDay = false) => {
    const suffix = endOfDay ? "T23:59:59+03:00" : "T00:00:00+03:00";
    return `${dateValue}${suffix}`;
  };

  const formatDateTime = (value: string) => new Intl.DateTimeFormat("uk-UA", {
    day: "2-digit",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "Europe/Kyiv"
  }).format(new Date(value));

  const updateAuthUi = async () => {
    if (!isSupabaseConfigured || !supabase) {
      setStatus("Додайте PUBLIC_SUPABASE_URL і PUBLIC_SUPABASE_ANON_KEY.", "warning");
      return;
    }

    const { data } = await supabase.auth.getSession();
    const isLoggedIn = Boolean(data.session);
    loginButton?.toggleAttribute("hidden", isLoggedIn);
    emailInput?.toggleAttribute("hidden", isLoggedIn);
    passwordInput?.toggleAttribute("hidden", isLoggedIn);
    logoutButton?.toggleAttribute("hidden", !isLoggedIn);
  };

  const renderBookings = (bookings: BoardBooking[]) => {
    if (!board) return;

    if (!bookings.length) {
      board.innerHTML = "<p>На вибраний період бронювань немає.</p>";
      return;
    }

    board.innerHTML = bookings.map((booking) => `
      <article class="booking-board-card" data-booking-id="${booking.id}">
        <div>
          <span class="booking-board-card__status" data-status="${booking.status}">${booking.status}</span>
          <h2>${booking.service_name}</h2>
          <p>${formatDateTime(booking.start_at)} - ${formatDateTime(booking.end_at)}</p>
        </div>
        <dl>
          <div><dt>Клієнт</dt><dd>${booking.customer_name}</dd></div>
          <div><dt>Телефон</dt><dd>${booking.customer_phone}</dd></div>
          <div><dt>Людей</dt><dd>${booking.party_size}</dd></div>
          <div><dt>Ресурси</dt><dd>${(booking.resource_names || []).join(", ")}</dd></div>
        </dl>
        ${booking.comment ? `<p class="booking-board-card__comment">${booking.comment}</p>` : ""}
        <div class="booking-board-card__actions">
          <button type="button" data-status-action="confirmed">Підтвердити</button>
          <button type="button" data-status-action="cancelled">Скасувати</button>
          <button type="button" data-status-action="completed">Завершено</button>
          <button type="button" data-status-action="no_show">No-show</button>
        </div>
      </article>
    `).join("");

    board.querySelectorAll<HTMLButtonElement>("[data-status-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        const card = button.closest<HTMLElement>("[data-booking-id]");
        const bookingId = card?.dataset.bookingId;
        const nextStatus = button.dataset.statusAction;
        if (!bookingId || !nextStatus) return;
        await updateStatus(bookingId, nextStatus);
      });
    });
  };

  const loadBoard = async () => {
    if (!isSupabaseConfigured || !supabase || !fromInput || !toInput) return false;
    if (!fromInput.value || !toInput.value) return false;

    setStatus("Завантажуємо календар...", "loading");
    const { data, error } = await supabase.rpc("list_booking_board", {
      p_from: toKyivRange(fromInput.value),
      p_to: toKyivRange(toInput.value, true)
    });

    if (error) {
      if (board) board.innerHTML = "<p>Немає доступу або сталася помилка.</p>";
      setStatus(formatAdminError(error.message), "error");
      return false;
    }

    renderBookings((data || []) as BoardBooking[]);
    setStatus("");
    return true;
  };

  const updateStatus = async (bookingId: string, nextStatus: string) => {
    if (!supabase) return;

    setStatus("Оновлюємо статус...", "loading");
    const { error } = await supabase.rpc("update_booking_status", {
      p_booking_id: bookingId,
      p_status: nextStatus,
      p_manager_note: null
    });

    if (error) {
      setStatus(formatAdminError(error.message), "error");
      return;
    }

    await loadBoard();
    setStatus("Статус оновлено.", "success");
  };

  loginButton?.addEventListener("click", async () => {
    if (!isSupabaseConfigured || !supabase) return;

    const email = emailInput?.value.trim() || "";
    const password = passwordInput?.value || "";

    if (!email || !password) {
      setStatus("Введіть email і пароль.", "error");
      return;
    }

    loginButton.disabled = true;
    setStatus("Входимо в адмінку...", "loading");
    const { error } = await supabase.auth.signInWithPassword({
      email,
      password
    });
    loginButton.disabled = false;

    if (error) {
      setStatus(formatAuthError(error.message), "error");
      return;
    }

    if (passwordInput) passwordInput.value = "";
    await updateAuthUi();
    const boardLoaded = await loadBoard();
    if (boardLoaded) setStatus("Вхід виконано.", "success");
  });

  [emailInput, passwordInput].forEach((input) => {
    input?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") loginButton?.click();
    });
  });

  logoutButton?.addEventListener("click", async () => {
    await supabase?.auth.signOut();
    await updateAuthUi();
    if (board) board.innerHTML = "<p>Увійдіть менеджером, щоб побачити бронювання.</p>";
  });

  loadButton?.addEventListener("click", loadBoard);

  blockForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!isSupabaseConfigured || !supabase) return;

    const formData = new FormData(blockForm);
    const startsAt = String(formData.get("starts_at"));
    const endsAt = String(formData.get("ends_at"));

    setStatus("Додаємо блокування...", "loading");
    const { error } = await supabase.rpc("add_blocked_time", {
      p_starts_at: startsAt ? new Date(startsAt).toISOString() : null,
      p_ends_at: endsAt ? new Date(endsAt).toISOString() : null,
      p_reason: String(formData.get("reason") || ""),
      p_resource_slug: String(formData.get("resource_slug") || "")
    });

    if (error) {
      setStatus(formatAdminError(error.message), "error");
      return;
    }

    blockForm.reset();
    await loadBoard();
    setStatus("Час заблоковано.", "success");
  });

  const today = new Date();
  const week = new Date();
  week.setDate(today.getDate() + 7);
  if (fromInput) fromInput.value = toDateInput(today);
  if (toInput) toInput.value = toDateInput(week);

  await updateAuthUi();
  if (isSupabaseConfigured) await loadBoard();
</script>
