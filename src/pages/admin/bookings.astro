---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="NOVA Admin · Бронювання"
  description="Перехід до єдиної адмін-панелі NOVA."
  canonicalPath="/admin/bookings/"
  robots="noindex,nofollow"
>
  <main class="nova-admin-redirect">
    <div>
      <span>Redirect</span>
      <h1>Бронювання переїхали в єдину адмінку</h1>
      <p>Відкриваємо розділ бронювань у новому `/admin`.</p>
      <a href="/admin#bookings">Перейти до бронювань</a>
    </div>
  </main>
  <script is:inline>
    window.location.replace("/admin#bookings");
  </script>
</BaseLayout>
