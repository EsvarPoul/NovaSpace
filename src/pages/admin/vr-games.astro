---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="NOVA Admin · Ігри"
  description="Перехід до єдиної адмін-панелі NOVA."
  canonicalPath="/admin/vr-games/"
  robots="noindex,nofollow"
>
  <main class="nova-admin-redirect">
    <div>
      <span>Redirect</span>
      <h1>Каталог ігор переїхав в єдину адмінку</h1>
      <p>Відкриваємо розділ ігор у новому `/admin`.</p>
      <a href="/admin#games">Перейти до ігор</a>
    </div>
  </main>
  <script is:inline>
    window.location.replace("/admin#games");
  </script>
</BaseLayout>
