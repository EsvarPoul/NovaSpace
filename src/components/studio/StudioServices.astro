---
import { studioServices } from "../../data/studio.js";
import Card from "../ui/Card.astro";
import Section from "../ui/Section.astro";
---

<Section
  id="services"
  eyebrow="Послуги"
  title="Зйомка з фотографом у студії"
  className="studio-section studio-services-section"
>
  <div class="studio-photographer" slot="text">
    <span>Фотограф: Владислава</span>
    <a href="https://www.instagram.com/vladensiya.photo/" target="_blank" rel="noreferrer" aria-label="Instagram Владислави">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <path d="M17.5 6.5h.01"></path>
      </svg>
      <span>@vladensiya.photo</span>
    </a>
  </div>
  <div class="grid grid--3">
    {studioServices.map((item) => (
      <Card eyebrow={item.type} title={item.title} text={item.text} className="studio-service-card">
        <strong>{item.price}</strong>
      </Card>
    ))}
  </div>
</Section>
