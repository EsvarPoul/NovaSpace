---
import { studioPortfolio } from "../../data/studio.js";
import Section from "../ui/Section.astro";
---

<Section
  id="portfolio"
  eyebrow="Атмосфера"
  title="3 зони для швидкого вибору кадру"
  text="Світлий фон, затишна зона і фактурне дерево. Оберіть настрій, решту підкажемо на місці."
  className="studio-section studio-mood"
>
  <div class="studio-mood-grid">
    {studioPortfolio.map((item) => (
      <article class="studio-mood-card">
        <img src={item.image} alt={`${item.title} у Nova PhotoStudio`} loading="lazy" />
        <div>
          <span>{item.type}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      </article>
    ))}
  </div>
</Section>
