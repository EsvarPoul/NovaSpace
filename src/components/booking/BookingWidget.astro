---
import { bookingServices as fallbackServices } from "../../data/bookingServices.js";

interface Props {
  allowedServiceSlugs?: string[];
  defaultServiceSlug?: string;
  variant?: "default" | "studio";
  introTitle?: string;
  introText?: string;
}

const {
  allowedServiceSlugs = [],
  defaultServiceSlug = "",
  variant = "default",
  introTitle = "Нове бронювання",
  introText = "Оберіть формат, дату і вільний слот. Заявка потрапить менеджеру на підтвердження."
} = Astro.props;

const showSummary = variant !== "studio";

const initialServices = allowedServiceSlugs.length
  ? fallbackServices.filter((service) => allowedServiceSlugs.includes(service.slug))
  : fallbackServices;

const selectedService = defaultServiceSlug || initialServices[0]?.slug || "";
const selectedServiceMeta = initialServices.find((service) => service.slug === selectedService) || initialServices[0];
const selectedMinPeople = selectedServiceMeta?.min_people ?? 1;
const selectedMaxPeople = selectedServiceMeta?.max_people ?? 12;
const selectedPartySize = Math.min(Math.max(2, selectedMinPeople), selectedMaxPeople);
const getServiceLabel = (service: { slug: string; name: string }) =>
  service.slug === "studio-rent" ? "Оренда студії" : service.name;
const formatPartySizeHelp = (min: number, max: number) =>
  min === max
    ? `Для цього формату: ${min} ${min === 1 ? "людина" : "людей"}`
    : `Для цього формату: від ${min} до ${max} людей`;
---

<section
  id="booking-form"
  class={`booking-shell booking-widget booking-widget--${variant}`}
  aria-label="Форма бронювання"
  data-booking-widget
  data-allowed-services={JSON.stringify(allowedServiceSlugs)}
  data-default-service={selectedService}
  data-booking-variant={variant}
>
  <form class="booking-panel booking-form" data-booking-form>
    <div class="booking-panel__head">
      <span>Запит на бронювання</span>
      <h2>{introTitle}</h2>
      <p>{introText}</p>
    </div>

    <label class="booking-field">
      <span>Послуга</span>
      <select name="service" data-service-select>
        {initialServices.map((service) => (
          <option
            value={service.slug}
            data-min={service.min_people}
            data-max={service.max_people}
            data-area={service.area}
            data-duration={service.duration_minutes}
            data-price-day={service.price_day}
            data-price-evening={service.price_evening}
            data-price-note={service.price_note}
            selected={service.slug === selectedService}
          >
            {getServiceLabel(service)}
          </option>
        ))}
      </select>
    </label>
    <p class="booking-price-note" data-booking-price hidden></p>

    <div class="booking-grid booking-grid--booking-context">
      <label class="booking-field">
        <span>Кількість людей</span>
        <input name="party_size" type="number" min={selectedMinPeople} max={selectedMaxPeople} value={selectedPartySize} data-party-size required />
        <small data-party-size-help>{formatPartySizeHelp(selectedMinPeople, selectedMaxPeople)}</small>
      </label>
      <label class="booking-field">
        <span>Дата</span>
        <input name="date" type="date" data-booking-date required />
      </label>
    </div>

    <div class="booking-slots">
      <div class="booking-slots__head">
        <span>Вільні слоти</span>
        <button type="button" data-refresh-slots>Оновити</button>
      </div>
      <div class="booking-slot-list" data-slot-list>
        <p>Оберіть дату, щоб побачити доступний час.</p>
      </div>
    </div>

    <div class="booking-grid">
      <label class="booking-field">
        <span>Ім'я</span>
        <input name="customer_name" type="text" autocomplete="name" required />
      </label>
      <label class="booking-field">
        <span>Телефон</span>
        <input name="customer_phone" type="tel" autocomplete="tel" required />
      </label>
    </div>

    <label class="booking-field">
      <span>Email (необов'язково)</span>
      <input name="customer_email" type="email" autocomplete="email" />
    </label>

    <label class="booking-field">
      <span>Коментар</span>
      <textarea name="comment" rows="4" placeholder="Формат події, вік дітей, побажання щодо PS5/фотографа, знижка УБД або інші деталі"></textarea>
    </label>

    <input type="hidden" name="slot_start" data-selected-slot />
    <button class="booking-submit" type="submit">Надіслати заявку</button>
    <p class="booking-status" data-booking-status role="status"></p>
  </form>

  {showSummary && (
    <aside class="booking-panel booking-summary">
      <div class="booking-panel__head">
        <span>Як це працює</span>
        <h2>Для VR менеджер підтвердить час і формат.</h2>
      </div>
      <ol>
        <li>День — Пн-Чт до 17:00. Вечір — після 17:00 та весь Пт-Нд.</li>
        <li>ДР бронюється на 3 години. Від 6 гостей це повна оренда VR клубу з 6 шоломами, PS5 і двома адміністраторами.</li>
        <li>УБД мають -10% на свою гру при показі посвідчення.</li>
        <li>Скретч-карти після гри у Пн-Ср працюють на наступний візит протягом місяця.</li>
      </ol>
    </aside>
  )}
</section>

<script>
  import { bookingServicePricing, bookingServices as fallbackServices } from "../../data/bookingServices.js";
  import { isSupabaseConfigured, supabase } from "../../lib/supabaseClient";

  interface BookingService {
    slug: string;
    name: string;
    area: string;
    duration_minutes: number;
    min_people: number;
    max_people: number;
    sort_order?: number;
    price_day?: string;
    price_evening?: string;
    price_note?: string;
  }

  interface Slot {
    slot_start: string;
    slot_end: string;
    available_places?: number;
    total_places?: number;
  }

  interface CreatedBooking {
    id?: string;
    start_at?: string;
    end_at?: string;
    status?: string;
  }

  const bookingWebhookUrl = import.meta.env.PUBLIC_BOOKING_WEBHOOK_URL ?? "";
  const bookingWebhookSecret = import.meta.env.PUBLIC_BOOKING_WEBHOOK_SECRET ?? "";
  const serviceSlugAliases: Record<string, string[]> = {
    "studio-rent": ["studio-light"]
  };

  const hasIntl = () => typeof Intl !== "undefined";

  const kyivDateKey = (date = new Date()) => {
    if (hasIntl()) {
      try {
        return new Intl.DateTimeFormat("en-CA", {
          day: "2-digit",
          month: "2-digit",
          timeZone: "Europe/Kyiv",
          year: "numeric"
        }).format(date);
      } catch {
        // Fall through to UTC date below.
      }
    }

    return date.toISOString().slice(0, 10);
  };

  const formatTime = (value: string) => {
    const date = new Date(value);
    if (hasIntl()) {
      try {
        return new Intl.DateTimeFormat("uk-UA", {
          hour: "2-digit",
          minute: "2-digit",
          timeZone: "Europe/Kyiv"
        }).format(date);
      } catch {
        // Fall through to HH:mm below.
      }
    }

    return date.toISOString().slice(11, 16);
  };

  const describeSlotError = (message: string) => {
    if (message.includes("Unknown or inactive service")) {
      return "Календар тимчасово не показує слоти для цього формату. Зателефонуйте нам - менеджер підбере час вручну.";
    }

    return "Календар тимчасово недоступний. Спробуйте оновити або зв'яжіться з менеджером.";
  };

  const describeBookingError = (message: string) => {
    if (message.includes("Unknown or inactive service")) {
      return "Цей формат ще не синхронізований у календарі. Зателефонуйте нам - менеджер забронює час вручну.";
    }

    if (message.includes("Party size is outside service limits")) {
      return "Кількість гостей не підходить для вибраного формату. Перевірте поле з кількістю людей.";
    }

    if (message.includes("Customer name is required")) {
      return "Вкажіть ім'я для бронювання.";
    }

    if (message.includes("Customer phone is required")) {
      return "Вкажіть коректний номер телефону.";
    }

    if (message.includes("Cannot create a booking in the past")) {
      return "Цей час уже минув. Оберіть інший слот.";
    }

    if (message.includes("Selected slot is no longer available")) {
      return "У цьому слоті вже недостатньо місць для вибраної кількості гостей. Оберіть інший час або зменшіть кількість людей.";
    }

    if (message.includes("Selected slot is blocked by manager")) {
      return "Цей час заблокований менеджером. Оберіть інший слот.";
    }

    return "Не вдалося створити бронювання. Спробуйте ще раз або зателефонуйте нам.";
  };

  const notifyBookingWebhook = async (bookingPayload: Record<string, unknown>) => {
    if (!bookingWebhookUrl) {
      return;
    }

    const headers: Record<string, string> = {
      "content-type": "application/json"
    };

    if (bookingWebhookSecret) {
      headers["x-booking-secret"] = bookingWebhookSecret;
    }

    const response = await fetch(bookingWebhookUrl, {
      method: "POST",
      headers,
      body: JSON.stringify(bookingPayload)
    });

    if (!response.ok) {
      console.warn("Booking notification webhook failed", response.status, await response.text());
    }
  };

  const setupBookingWidget = async (root: HTMLElement) => {
    const form = root.querySelector<HTMLFormElement>("[data-booking-form]");
    const serviceSelect = root.querySelector<HTMLSelectElement>("[data-service-select]");
    const dateInput = root.querySelector<HTMLInputElement>("[data-booking-date]");
    const partySizeInput = root.querySelector<HTMLInputElement>("[data-party-size]");
    const partySizeHelp = root.querySelector<HTMLElement>("[data-party-size-help]");
    const slotInput = root.querySelector<HTMLInputElement>("[data-selected-slot]");
    const slotList = root.querySelector<HTMLElement>("[data-slot-list]");
    const status = root.querySelector<HTMLElement>("[data-booking-status]");
    const refreshButton = root.querySelector<HTMLButtonElement>("[data-refresh-slots]");
    const priceHint = root.querySelector<HTMLElement>("[data-booking-price]");
    const allowed = JSON.parse(root.dataset.allowedServices || "[]") as string[];
    const defaultService = root.dataset.defaultService || "";
    const isStudioVariant = root.dataset.bookingVariant === "studio";
    const requestedService = new URLSearchParams(window.location.search).get("service") || "";
    const knownServiceSlugs = new Set(fallbackServices.map((service) => service.slug));
    const servicesWithoutPriceHint = new Set(["birthday-3h", "studio-rent"]);

    const filterServices = (services: BookingService[]) => {
      const currentServices = services.filter((service) => knownServiceSlugs.has(service.slug));
      return allowed.length
        ? currentServices.filter((service) => allowed.includes(service.slug))
        : currentServices;
    };

    const getSelectedServiceSlug = () => {
      const option = serviceSelect?.selectedOptions[0];
      return option?.dataset.submitSlug || serviceSelect?.value || "";
    };

    const setStatus = (message: string, state = "idle") => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
    };

    const escapeHtml = (value: unknown) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

    const getServicePricing = (option?: HTMLOptionElement | null) => {
      const meta = (option ? bookingServicePricing[option.value] || {} : {}) as {
        price_day?: string;
        price_evening?: string;
        price_note?: string;
      };
      return {
        day: option?.dataset.priceDay || meta.price_day || "",
        evening: option?.dataset.priceEvening || meta.price_evening || "",
        note: option?.dataset.priceNote || meta.price_note || ""
      };
    };

    const getSlotTariff = (slotValue: string) => {
      if (!slotValue) return "";
      const slotDate = new Date(slotValue);
      let weekday = "";
      let hour = slotDate.getUTCHours();

      if (hasIntl()) {
        try {
          weekday = new Intl.DateTimeFormat("en-US", {
            weekday: "short",
            timeZone: "Europe/Kyiv"
          }).format(slotDate);
          hour = Number(new Intl.DateTimeFormat("en-GB", {
            hour: "2-digit",
            hour12: false,
            timeZone: "Europe/Kyiv"
          }).format(slotDate));
        } catch {
          weekday = "";
        }
      }

      return ["Fri", "Sat", "Sun"].includes(weekday) || hour >= 17 ? "evening" : "day";
    };

    const shouldHidePriceHint = (option?: HTMLOptionElement | null) =>
      !option || servicesWithoutPriceHint.has(option.value) || option.dataset.area === "studio";

    const renderPriceHint = (slotValue = "") => {
      if (!priceHint || !serviceSelect) return;
      const option = serviceSelect.selectedOptions[0];
      if (shouldHidePriceHint(option)) {
        priceHint.hidden = true;
        priceHint.textContent = "";
        return;
      }

      const pricing = getServicePricing(option);
      const note = pricing.note ? ` · ${pricing.note}` : "";
      priceHint.hidden = false;

      if (!pricing.day && !pricing.evening) {
        priceHint.textContent = "Менеджер уточнить вартість після заявки.";
        return;
      }

      const tariff = getSlotTariff(slotValue);
      if (tariff === "day") {
        priceHint.textContent = `Денний тариф: ${pricing.day}${note}`;
        return;
      }

      if (tariff === "evening") {
        priceHint.textContent = `Вечірній тариф: ${pricing.evening}${note}`;
        return;
      }

      priceHint.textContent = `День: ${pricing.day} · Вечір / Пт-Нд: ${pricing.evening}${note}`;
    };

    const trackAdsConversion = (actionName: string, eventParams: Record<string, unknown> = {}) => {
      const tracker = (window as typeof window & {
        novaTrackAdsConversion?: (actionName: string, eventParams?: Record<string, unknown>) => void;
      }).novaTrackAdsConversion;

      if (tracker) tracker(actionName, eventParams);
    };

    const getServiceLabel = (service: Pick<BookingService, "slug" | "name">) =>
      service.slug === "studio-rent" ? "Оренда студії" : service.name;

    const setSelectedSlot = (button: HTMLButtonElement) => {
      root.querySelectorAll("[data-slot]").forEach((item) => item.classList.remove("is-selected"));
      button.classList.add("is-selected");
      if (slotInput) slotInput.value = button.dataset.slot || "";
      renderPriceHint(button.dataset.slot || "");
    };

    const shouldShowSlotCapacity = (slot: Slot) => {
      const selectedSlug = serviceSelect?.selectedOptions[0]?.value || "";
      const totalPlaces = Number(slot.total_places || 0);
      const availablePlaces = Number(slot.available_places || 0);
      return selectedSlug.startsWith("vr-") && totalPlaces > 1 && availablePlaces >= 0;
    };

    const renderSlots = (slots: Slot[]) => {
      if (!slotList) return;
      if (slotInput) slotInput.value = "";
      renderPriceHint("");

      if (!slots.length) {
        slotList.innerHTML = "<p>На цю дату немає вільних слотів для вибраної послуги.</p>";
        return;
      }

      slotList.innerHTML = slots.map((slot) => `
        <button type="button" data-slot="${slot.slot_start}">
          <strong>${formatTime(slot.slot_start)}</strong>
          <span>${formatTime(slot.slot_end)}</span>
          ${shouldShowSlotCapacity(slot) ? `<small>Доступно ${escapeHtml(slot.available_places)} з ${escapeHtml(slot.total_places)} місць</small>` : ""}
        </button>
      `).join("");

      slotList.querySelectorAll<HTMLButtonElement>("[data-slot]").forEach((button) => {
        button.addEventListener("click", () => setSelectedSlot(button));
      });
    };

    const syncPartyBounds = () => {
      const option = serviceSelect?.selectedOptions[0];
      if (!option || !partySizeInput) return;

      const min = option.dataset.min || "1";
      const max = option.dataset.max || "12";
      partySizeInput.min = min;
      partySizeInput.max = max;

      const current = Number(partySizeInput.value || min);
      partySizeInput.value = String(Math.min(Math.max(current, Number(min)), Number(max)));
      if (partySizeHelp) {
        partySizeHelp.textContent = min === max
          ? `Для цього формату: ${min} ${Number(min) === 1 ? "людина" : "людей"}`
          : `Для цього формату: від ${min} до ${max} людей`;
      }
      renderPriceHint(slotInput?.value || "");
    };

    const populateServices = (services: BookingService[]) => {
      if (!serviceSelect) return;
      const availableServices = new Map(services.map((service) => [service.slug, service]));
      const filtered = filterServices(services);
      const fallbackFiltered = filterServices(fallbackServices);
      const hasLiveService = (service: BookingService) => availableServices.has(service.slug)
        || (serviceSlugAliases[service.slug] || []).some((alias) => availableServices.has(alias));
      const servicesToRender = [...filtered];

      fallbackFiltered.forEach((service) => {
        if (servicesToRender.some((renderedService) => renderedService.slug === service.slug)) return;
        if (filtered.length && !hasLiveService(service)) return;
        servicesToRender.push(service);
      });

      const addFallbackService = (slug: string) => {
        if (!slug || servicesToRender.some((service) => service.slug === slug)) return;
        if (allowed.length && !allowed.includes(slug)) return;
        const fallbackService = fallbackFiltered.find((service) => service.slug === slug);
        if (fallbackService) servicesToRender.push(fallbackService);
      };

      addFallbackService(requestedService);
      addFallbackService(defaultService);

      const preferredService = servicesToRender.some((service) => service.slug === requestedService)
        ? requestedService
        : servicesToRender.some((service) => service.slug === defaultService)
          ? defaultService
          : servicesToRender[0]?.slug || "";

      if (!servicesToRender.length) {
        serviceSelect.innerHTML = "";
        setStatus("Немає доступних послуг для цього блоку бронювання.", "error");
        return;
      }

      serviceSelect.innerHTML = servicesToRender.map((service) => {
        const submitSlug = availableServices.has(service.slug)
          ? service.slug
          : (serviceSlugAliases[service.slug] || []).find((alias) => availableServices.has(alias)) || service.slug;
        const submitService = availableServices.get(submitSlug);
        const minPeople = submitService ? Math.max(service.min_people, submitService.min_people) : service.min_people;
        const maxPeople = submitService ? Math.min(service.max_people, submitService.max_people) : service.max_people;
        const pricing = {
          ...((bookingServicePricing[service.slug] || {}) as Record<string, string>),
          price_day: service.price_day || (bookingServicePricing[service.slug] as any)?.price_day || "",
          price_evening: service.price_evening || (bookingServicePricing[service.slug] as any)?.price_evening || "",
          price_note: service.price_note || (bookingServicePricing[service.slug] as any)?.price_note || ""
        };
        return `
        <option
          value="${escapeHtml(service.slug)}"
          data-submit-slug="${escapeHtml(submitSlug)}"
          data-min="${escapeHtml(minPeople)}"
          data-max="${escapeHtml(maxPeople)}"
          data-area="${escapeHtml(service.area)}"
          data-duration="${escapeHtml(service.duration_minutes)}"
          data-price-day="${escapeHtml(pricing.price_day)}"
          data-price-evening="${escapeHtml(pricing.price_evening)}"
          data-price-note="${escapeHtml(pricing.price_note)}"
          ${service.slug === preferredService ? "selected" : ""}
        >
          ${escapeHtml(getServiceLabel(service))}
        </option>
      `;
      }).join("");

      if (preferredService) {
        serviceSelect.value = preferredService;
      }

      syncPartyBounds();
      renderPriceHint(slotInput?.value || "");
    };

    const loadServices = async () => {
      if (!isSupabaseConfigured || !supabase || !serviceSelect) {
        populateServices(fallbackServices);
        setStatus("Онлайн-календар тимчасово недоступний. Можна уточнити час телефоном.", "warning");
        return;
      }

      const { data, error } = await supabase
        .from("services")
        .select("slug,name,area,duration_minutes,min_people,max_people,sort_order")
        .eq("active", true)
        .order("sort_order", { ascending: true });

      if (error || !data?.length) {
        populateServices(fallbackServices);
        setStatus("Показуємо локальний список послуг. Доступний час можна уточнити телефоном.", "warning");
        return;
      }

      populateServices(data as BookingService[]);
      setStatus("");
    };

    const loadSlots = async () => {
      syncPartyBounds();
      if (slotInput) slotInput.value = "";
      root.querySelectorAll("[data-slot]").forEach((item) => item.classList.remove("is-selected"));

      if (!slotList || !serviceSelect || !dateInput || !partySizeInput) return;
      if (!dateInput.value) {
        renderSlots([]);
        slotList.innerHTML = "<p>Оберіть дату, щоб побачити доступний час.</p>";
        return;
      }

      if (!isSupabaseConfigured || !supabase) {
        slotList.innerHTML = '<p>Онлайн-календар тимчасово недоступний. Для швидкого бронювання зателефонуйте: <a href="tel:+380660097630">066 009 76 30</a>.</p>';
        setStatus("Можна уточнити час телефоном або написати в Instagram.", "warning");
        return;
      }

      slotList.innerHTML = "<p>Завантажуємо слоти...</p>";
      setStatus("Перевіряємо доступний час...", "loading");
      const { data, error } = await supabase.rpc("get_available_slots", {
        p_service_slug: getSelectedServiceSlug(),
        p_date: dateInput.value,
        p_party_size: Number(partySizeInput.value),
        p_step_minutes: 30
      });

      if (error) {
        slotList.innerHTML = `<p>${describeSlotError(error.message)} <a href="tel:+380660097630">066 009 76 30</a></p>`;
        setStatus("Для цього формату краще підтвердити час з менеджером.", "warning");
        return;
      }

      renderSlots((data || []) as Slot[]);
      setStatus("");
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!isSupabaseConfigured || !supabase) {
        setStatus("Онлайн-календар тимчасово недоступний. Зателефонуйте нам для бронювання.", "error");
        return;
      }

      if (!slotInput?.value) {
        setStatus("Оберіть вільний слот або зателефонуйте, якщо календар не показує час.", "error");
        return;
      }

      const formData = new FormData(form);
      setStatus("Створюємо pending-бронювання...", "loading");

      const serviceName = serviceSelect?.selectedOptions[0]?.textContent?.trim() || String(formData.get("service"));
      const bookingPayload = {
        id: "",
        service: serviceName,
        serviceSlug: String(formData.get("service")),
        databaseServiceSlug: getSelectedServiceSlug(),
        name: String(formData.get("customer_name") || ""),
        phone: String(formData.get("customer_phone") || ""),
        partySize: Number(formData.get("party_size")),
        email: String(formData.get("customer_email") || ""),
        comment: String(formData.get("comment") || ""),
        startsAt: slotInput.value,
        endsAt: "",
        status: "pending"
      };

      const { data: createdBooking, error } = await supabase.rpc("create_pending_booking", {
        p_service_slug: getSelectedServiceSlug(),
        p_start_at: slotInput.value,
        p_customer_name: bookingPayload.name,
        p_customer_phone: bookingPayload.phone,
        p_party_size: bookingPayload.partySize,
        p_customer_email: bookingPayload.email,
        p_comment: bookingPayload.comment
      });

      if (error) {
        setStatus(describeBookingError(error.message), "error");
        await loadSlots();
        return;
      }

      const createdBookingRecord = (Array.isArray(createdBooking) ? createdBooking[0] : createdBooking) as CreatedBooking | null;
      bookingPayload.id = createdBookingRecord?.id || "";
      bookingPayload.startsAt = createdBookingRecord?.start_at || bookingPayload.startsAt;
      bookingPayload.endsAt = createdBookingRecord?.end_at || "";
      bookingPayload.status = createdBookingRecord?.status || bookingPayload.status;

      try {
        await notifyBookingWebhook(bookingPayload);
      } catch (notificationError) {
        console.warn("Booking notification webhook failed", notificationError);
      }

      form.reset();
      syncPartyBounds();
      await loadSlots();
      trackAdsConversion("submit_form", {
        service: bookingPayload.serviceSlug,
        database_service: bookingPayload.databaseServiceSlug
      });
      setStatus(isStudioVariant ? "Заявку створено." : "Заявку створено. Менеджер підтвердить VR-бронювання.", "success");
    });

    if (dateInput) {
      const today = kyivDateKey();
      dateInput.min = today;
      dateInput.value = today;
    }

    serviceSelect?.addEventListener("change", loadSlots);
    dateInput?.addEventListener("change", loadSlots);
    partySizeInput?.addEventListener("change", loadSlots);
    refreshButton?.addEventListener("click", loadSlots);

    await loadServices();
    await loadSlots();
  };

  document.querySelectorAll<HTMLElement>("[data-booking-widget]").forEach((widget) => {
    setupBookingWidget(widget);
  });
</script>
