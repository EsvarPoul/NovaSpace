---
import { bookingServices as fallbackServices } from "../../data/bookingServices.js";

interface Props {
  allowedServiceSlugs?: string[];
  defaultServiceSlug?: string;
  variant?: "default" | "studio";
  introTitle?: string;
  introText?: string;
}

const {
  allowedServiceSlugs = [],
  defaultServiceSlug = "",
  variant = "default",
  introTitle = "Нове бронювання",
  introText = "Оберіть формат, дату і вільний слот. Заявка потрапить менеджеру на підтвердження."
} = Astro.props;

const showSummary = variant !== "studio";

const initialServices = allowedServiceSlugs.length
  ? fallbackServices.filter((service) => allowedServiceSlugs.includes(service.slug))
  : fallbackServices;

const selectedService = defaultServiceSlug || initialServices[0]?.slug || "";
---

<section
  id="booking-form"
  class={`booking-shell booking-widget booking-widget--${variant}`}
  aria-label="Форма бронювання"
  data-booking-widget
  data-allowed-services={JSON.stringify(allowedServiceSlugs)}
  data-default-service={selectedService}
>
  <form class="booking-panel booking-form" data-booking-form>
    <div class="booking-panel__head">
      <span>Запит на бронювання</span>
      <h2>{introTitle}</h2>
      <p>{introText}</p>
    </div>

    <label class="booking-field">
      <span>Послуга</span>
      <select name="service" data-service-select>
        {initialServices.map((service) => (
          <option
            value={service.slug}
            data-min={service.min_people}
            data-max={service.max_people}
            data-duration={service.duration_minutes}
            data-price-day={service.price_day}
            data-price-evening={service.price_evening}
            data-price-note={service.price_note}
            selected={service.slug === selectedService}
          >
            {service.name}
          </option>
        ))}
      </select>
    </label>
    <p class="booking-price-note" data-booking-price>Оберіть формат і слот, щоб побачити актуальний тариф.</p>

    <div class="booking-grid">
      <label class="booking-field">
        <span>Дата</span>
        <input name="date" type="date" data-booking-date required />
      </label>
      <label class="booking-field">
        <span>Кількість людей</span>
        <input name="party_size" type="number" min="1" max="12" value="2" data-party-size required />
      </label>
    </div>

    <div class="booking-slots">
      <div class="booking-slots__head">
        <span>Вільні слоти</span>
        <button type="button" data-refresh-slots>Оновити</button>
      </div>
      <div class="booking-slot-list" data-slot-list>
        <p>Оберіть дату, щоб побачити доступний час.</p>
      </div>
    </div>

    <div class="booking-grid">
      <label class="booking-field">
        <span>Ім'я</span>
        <input name="customer_name" type="text" autocomplete="name" required />
      </label>
      <label class="booking-field">
        <span>Телефон</span>
        <input name="customer_phone" type="tel" autocomplete="tel" required />
      </label>
    </div>

    <label class="booking-field">
      <span>Email (необов'язково)</span>
      <input name="customer_email" type="email" autocomplete="email" />
    </label>

    <label class="booking-field">
      <span>Коментар</span>
      <textarea name="comment" rows="4" placeholder="Формат події, вік дітей, побажання щодо PS5/фотографа, знижка УБД або інші деталі"></textarea>
    </label>

    <input type="hidden" name="slot_start" data-selected-slot />
    <button class="booking-submit" type="submit">Надіслати заявку</button>
    <p class="booking-status" data-booking-status role="status"></p>
  </form>

  {showSummary && (
    <aside class="booking-panel booking-summary">
      <div class="booking-panel__head">
        <span>Як це працює</span>
        <h2>Менеджер підтвердить час, тариф і формат.</h2>
      </div>
      <ol>
        <li>День — Пн-Чт до 17:00. Вечір — після 17:00 та весь Пт-Нд.</li>
        <li>ДР бронюється на 3 години. Від 6 гостей це повна оренда VR клубу з 6 шоломами, PS5 і двома адміністраторами.</li>
        <li>УБД мають -20% на свою гру при показі посвідчення. На ДР знижки не діють.</li>
        <li>Скретч-карти після гри у Пн-Ср працюють на наступний візит протягом місяця.</li>
      </ol>
    </aside>
  )}
</section>

<script>
  import { bookingServicePricing, bookingServices as fallbackServices } from "../../data/bookingServices.js";
  import { isSupabaseConfigured, supabase } from "../../lib/supabaseClient";

  interface BookingService {
    slug: string;
    name: string;
    area: string;
    duration_minutes: number;
    min_people: number;
    max_people: number;
    sort_order?: number;
    price_day?: string;
    price_evening?: string;
    price_note?: string;
  }

  interface Slot {
    slot_start: string;
    slot_end: string;
  }

  interface CreatedBooking {
    id?: string;
    start_at?: string;
    end_at?: string;
    status?: string;
  }

  const bookingWebhookSecret = import.meta.env.PUBLIC_BOOKING_WEBHOOK_SECRET ?? "";

  const formatTime = (value: string) => new Intl.DateTimeFormat("uk-UA", {
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "Europe/Kyiv"
  }).format(new Date(value));

  const describeSlotError = (message: string) => {
    if (message.includes("Unknown or inactive service")) {
      return "У базі ще немає активної послуги з актуального прайсу. Застосуйте Supabase migration 0003_vr_pricing_services.sql, після цього слоти з'являться автоматично.";
    }

    return message || "Невідома помилка календаря.";
  };

  const setupBookingWidget = async (root: HTMLElement) => {
    const form = root.querySelector<HTMLFormElement>("[data-booking-form]");
    const serviceSelect = root.querySelector<HTMLSelectElement>("[data-service-select]");
    const dateInput = root.querySelector<HTMLInputElement>("[data-booking-date]");
    const partySizeInput = root.querySelector<HTMLInputElement>("[data-party-size]");
    const slotInput = root.querySelector<HTMLInputElement>("[data-selected-slot]");
    const slotList = root.querySelector<HTMLElement>("[data-slot-list]");
    const status = root.querySelector<HTMLElement>("[data-booking-status]");
    const refreshButton = root.querySelector<HTMLButtonElement>("[data-refresh-slots]");
    const priceHint = root.querySelector<HTMLElement>("[data-booking-price]");
    const allowed = JSON.parse(root.dataset.allowedServices || "[]") as string[];
    const defaultService = root.dataset.defaultService || "";
    const knownServiceSlugs = new Set(fallbackServices.map((service) => service.slug));

    const filterServices = (services: BookingService[]) => {
      const currentServices = services.filter((service) => knownServiceSlugs.has(service.slug));
      return allowed.length
        ? currentServices.filter((service) => allowed.includes(service.slug))
        : currentServices;
    };

    const setStatus = (message: string, state = "idle") => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
    };

    const escapeHtml = (value: unknown) => String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

    const getServicePricing = (option?: HTMLOptionElement | null) => {
      const meta = (option ? bookingServicePricing[option.value] || {} : {}) as {
        price_day?: string;
        price_evening?: string;
        price_note?: string;
      };
      return {
        day: option?.dataset.priceDay || meta.price_day || "",
        evening: option?.dataset.priceEvening || meta.price_evening || "",
        note: option?.dataset.priceNote || meta.price_note || ""
      };
    };

    const getSlotTariff = (slotValue: string) => {
      if (!slotValue) return "";
      const slotDate = new Date(slotValue);
      const weekday = new Intl.DateTimeFormat("en-US", {
        weekday: "short",
        timeZone: "Europe/Kyiv"
      }).format(slotDate);
      const hour = Number(new Intl.DateTimeFormat("en-GB", {
        hour: "2-digit",
        hour12: false,
        timeZone: "Europe/Kyiv"
      }).format(slotDate));

      return ["Fri", "Sat", "Sun"].includes(weekday) || hour >= 17 ? "evening" : "day";
    };

    const renderPriceHint = (slotValue = "") => {
      if (!priceHint || !serviceSelect) return;
      const pricing = getServicePricing(serviceSelect.selectedOptions[0]);
      const note = pricing.note ? ` · ${pricing.note}` : "";

      if (!pricing.day && !pricing.evening) {
        priceHint.textContent = "Менеджер уточнить вартість після заявки.";
        return;
      }

      const tariff = getSlotTariff(slotValue);
      if (tariff === "day") {
        priceHint.textContent = `Денний тариф: ${pricing.day}${note}`;
        return;
      }

      if (tariff === "evening") {
        priceHint.textContent = `Вечірній тариф: ${pricing.evening}${note}`;
        return;
      }

      priceHint.textContent = `День: ${pricing.day} · Вечір / Пт-Нд: ${pricing.evening}${note}`;
    };

    const setSelectedSlot = (button: HTMLButtonElement) => {
      root.querySelectorAll("[data-slot]").forEach((item) => item.classList.remove("is-selected"));
      button.classList.add("is-selected");
      if (slotInput) slotInput.value = button.dataset.slot || "";
      renderPriceHint(button.dataset.slot || "");
    };

    const renderSlots = (slots: Slot[]) => {
      if (!slotList) return;
      if (slotInput) slotInput.value = "";
      renderPriceHint("");

      if (!slots.length) {
        slotList.innerHTML = "<p>На цю дату немає вільних слотів для вибраної послуги.</p>";
        return;
      }

      slotList.innerHTML = slots.map((slot) => `
        <button type="button" data-slot="${slot.slot_start}">
          <strong>${formatTime(slot.slot_start)}</strong>
          <span>${formatTime(slot.slot_end)}</span>
        </button>
      `).join("");

      slotList.querySelectorAll<HTMLButtonElement>("[data-slot]").forEach((button) => {
        button.addEventListener("click", () => setSelectedSlot(button));
      });
    };

    const syncPartyBounds = () => {
      const option = serviceSelect?.selectedOptions[0];
      if (!option || !partySizeInput) return;

      const min = option.dataset.min || "1";
      const max = option.dataset.max || "12";
      partySizeInput.min = min;
      partySizeInput.max = max;

      const current = Number(partySizeInput.value || min);
      partySizeInput.value = String(Math.min(Math.max(current, Number(min)), Number(max)));
      renderPriceHint(slotInput?.value || "");
    };

    const populateServices = (services: BookingService[]) => {
      if (!serviceSelect) return;
      const filtered = filterServices(services);
      const fallbackFiltered = filterServices(fallbackServices);
      const servicesToRender = filtered.length ? filtered : fallbackFiltered;

      if (!servicesToRender.length) {
        serviceSelect.innerHTML = "";
        setStatus("Немає доступних послуг для цього блоку бронювання.", "error");
        return;
      }

      serviceSelect.innerHTML = servicesToRender.map((service) => {
        const pricing = {
          ...((bookingServicePricing[service.slug] || {}) as Record<string, string>),
          price_day: service.price_day || (bookingServicePricing[service.slug] as any)?.price_day || "",
          price_evening: service.price_evening || (bookingServicePricing[service.slug] as any)?.price_evening || "",
          price_note: service.price_note || (bookingServicePricing[service.slug] as any)?.price_note || ""
        };

        return `
        <option
          value="${escapeHtml(service.slug)}"
          data-min="${escapeHtml(service.min_people)}"
          data-max="${escapeHtml(service.max_people)}"
          data-duration="${escapeHtml(service.duration_minutes)}"
          data-price-day="${escapeHtml(pricing.price_day)}"
          data-price-evening="${escapeHtml(pricing.price_evening)}"
          data-price-note="${escapeHtml(pricing.price_note)}"
          ${service.slug === defaultService ? "selected" : ""}
        >
          ${escapeHtml(service.name)}
        </option>
      `;
      }).join("");

      if (defaultService && servicesToRender.some((service) => service.slug === defaultService)) {
        serviceSelect.value = defaultService;
      }

      syncPartyBounds();
      renderPriceHint(slotInput?.value || "");
    };

    const loadServices = async () => {
      if (!isSupabaseConfigured || !supabase || !serviceSelect) {
        populateServices(fallbackServices);
        setStatus("Supabase ще не налаштовано. Після додавання env-змінних і SQL migration тут з'являться живі слоти.", "warning");
        return;
      }

      const { data, error } = await supabase
        .from("services")
        .select("slug,name,area,duration_minutes,min_people,max_people,sort_order")
        .eq("active", true)
        .order("sort_order", { ascending: true });

      if (error || !data?.length) {
        populateServices(fallbackServices);
        setStatus(error?.message || "Не вдалося завантажити послуги, показуємо локальний список.", "warning");
        return;
      }

      populateServices(data as BookingService[]);
      setStatus("");
    };

    const loadSlots = async () => {
      syncPartyBounds();
      if (slotInput) slotInput.value = "";
      root.querySelectorAll("[data-slot]").forEach((item) => item.classList.remove("is-selected"));
      renderPriceHint("");

      if (!slotList || !serviceSelect || !dateInput || !partySizeInput) return;
      if (!dateInput.value) {
        renderSlots([]);
        slotList.innerHTML = "<p>Оберіть дату, щоб побачити доступний час.</p>";
        return;
      }

      if (!isSupabaseConfigured || !supabase) {
        slotList.innerHTML = "<p>Живі слоти з'являться після підключення Supabase.</p>";
        setStatus("Supabase ще не налаштовано. Форма готова, але календар поки працює без реальних слотів.", "warning");
        return;
      }

      slotList.innerHTML = "<p>Завантажуємо слоти...</p>";
      setStatus("Перевіряємо доступний час...", "loading");
      const { data, error } = await supabase.rpc("get_available_slots", {
        p_service_slug: serviceSelect.value,
        p_date: dateInput.value,
        p_party_size: Number(partySizeInput.value),
        p_step_minutes: 30
      });

      if (error) {
        slotList.innerHTML = `<p>Не вдалося завантажити слоти. ${describeSlotError(error.message)}</p>`;
        setStatus("Не вдалося перевірити календар. Спробуйте ще раз або залиште контакт без вибору слоту.", "error");
        return;
      }

      renderSlots((data || []) as Slot[]);
      setStatus("");
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!isSupabaseConfigured || !supabase) {
        setStatus("Спершу підключіть Supabase env-змінні.", "error");
        return;
      }

      if (!slotInput?.value) {
        setStatus("Оберіть вільний слот.", "error");
        return;
      }

      const formData = new FormData(form);
      setStatus("Створюємо pending-бронювання...", "loading");

      const serviceName = serviceSelect?.selectedOptions[0]?.textContent?.trim() || String(formData.get("service"));
      const bookingPayload = {
        id: "",
        service: serviceName,
        serviceSlug: String(formData.get("service")),
        name: String(formData.get("customer_name") || ""),
        phone: String(formData.get("customer_phone") || ""),
        partySize: Number(formData.get("party_size")),
        email: String(formData.get("customer_email") || ""),
        comment: String(formData.get("comment") || ""),
        startsAt: slotInput.value,
        endsAt: "",
        status: "pending"
      };

      const { data: createdBooking, error } = await supabase.rpc("create_pending_booking", {
        p_service_slug: String(formData.get("service")),
        p_start_at: slotInput.value,
        p_customer_name: bookingPayload.name,
        p_customer_phone: bookingPayload.phone,
        p_party_size: bookingPayload.partySize,
        p_customer_email: bookingPayload.email,
        p_comment: bookingPayload.comment
      });

      if (error) {
        setStatus(error.message, "error");
        await loadSlots();
        return;
      }

      const createdBookingRecord = (Array.isArray(createdBooking) ? createdBooking[0] : createdBooking) as CreatedBooking | null;
      bookingPayload.id = createdBookingRecord?.id || "";
      bookingPayload.startsAt = createdBookingRecord?.start_at || bookingPayload.startsAt;
      bookingPayload.endsAt = createdBookingRecord?.end_at || "";
      bookingPayload.status = createdBookingRecord?.status || bookingPayload.status;

      try {
        const headers: Record<string, string> = {
          "content-type": "application/json"
        };

        if (bookingWebhookSecret) {
          headers["x-booking-secret"] = bookingWebhookSecret;
        }

        const response = await fetch("/api/booking", {
          method: "POST",
          headers,
          body: JSON.stringify(bookingPayload)
        });

        if (!response.ok) {
          console.warn("Telegram booking notification failed", response.status, await response.text());
        }
      } catch (notificationError) {
        console.warn("Telegram booking notification failed", notificationError);
      }

      form.reset();
      syncPartyBounds();
      await loadSlots();
      setStatus("Заявку створено. Менеджер підтвердить бронювання.", "success");
    });

    const today = new Date();
    today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
    if (dateInput) {
      dateInput.min = today.toISOString().slice(0, 10);
      dateInput.value = today.toISOString().slice(0, 10);
    }

    serviceSelect?.addEventListener("change", loadSlots);
    dateInput?.addEventListener("change", loadSlots);
    partySizeInput?.addEventListener("change", loadSlots);
    refreshButton?.addEventListener("click", loadSlots);

    await loadServices();
    await loadSlots();
  };

  document.querySelectorAll<HTMLElement>("[data-booking-widget]").forEach((widget) => {
    setupBookingWidget(widget);
  });
</script>
