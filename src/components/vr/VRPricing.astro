---
import { vrPricing, vrPricingNotes } from "../../data/vr.js";
import Section from "../ui/Section.astro";
---

<Section id="pricing" eyebrow="Формати та вартість" title="Актуальна сітка цін для VR, PS5, NovaMix і ДР." className="vr-app-section vr-presets">
  <div class="vr-price-board">
    {vrPricing.map((group: any) => (
      <article class="vr-price-card">
        <div>
          <span>{group.note}</span>
          <strong>{group.title}</strong>
        </div>
        <table>
          <thead>
            <tr>
              <th>Формат</th>
              {group.columns.map((column: string) => <th>{column}</th>)}
            </tr>
          </thead>
          <tbody>
            {group.rows.map((row: any) => (
              <tr>
                <th>{row.label}</th>
                {row.values.map((value: string) => <td>{value}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </article>
    ))}
  </div>
  <div class="vr-pricing-notes">
    {vrPricingNotes.map((note: any) => (
      <article>
        <strong>{note.title}</strong>
        <p>{note.text}</p>
      </article>
    ))}
  </div>
</Section>
