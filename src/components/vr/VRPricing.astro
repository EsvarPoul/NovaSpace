---
import { vrPricing } from "../../data/vr.js";
import Card from "../ui/Card.astro";
import Section from "../ui/Section.astro";
---

<Section id="pricing" eyebrow="Session presets" title="Пресети запуску для різних команд." className="vr-app-section vr-presets">
  <div class="grid grid--3 vr-preset-grid">
    {vrPricing.map((item) => (
      <Card eyebrow={item.meta} title={item.name} className="price-card price-card--vr vr-preset-card">
        <strong>{item.price}</strong>
        <ul>{item.features.map((feature) => <li>{feature}</li>)}</ul>
        <a href="tel:+380XXXXXXXXX" class="vr-preset-action">Запустити</a>
      </Card>
    ))}
  </div>
</Section>
