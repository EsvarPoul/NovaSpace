---
import { vrGames } from "../../data/vr.js";
import Section from "../ui/Section.astro";
---

<Section
  id="games"
  eyebrow="Modules"
  title="Обери ігровий модуль як у лаунчері."
  text="Картки працюють як швидкий вибір сценарію: жанр, склад команди, рівень інтенсивності та короткий опис без довгих продажних блоків."
  className="vr-app-section vr-modules"
>
  <div class="filter-row vr-filter-row" role="list" aria-label="Фільтри ігрових модулів">
    <button class="chip is-active" type="button" data-filter="all">Усі</button>
    <button class="chip" type="button" data-filter="Co-op">Co-op</button>
    <button class="chip" type="button" data-filter="Action">Action</button>
    <button class="chip" type="button" data-filter="Story">Story</button>
    <button class="chip" type="button" data-filter="Horror">Horror</button>
  </div>
  <div class="grid grid--4 vr-module-grid">
    {vrGames.map((game) => (
      <article class="game-card vr-module-card" data-game-category={game.genre}>
        <div class="game-cover vr-module-cover" aria-hidden="true">
          <span></span>
        </div>
        <div class="game-meta"><span>{game.genre}</span><span>{game.players}</span></div>
        <h3>{game.title}</h3>
        <strong>{game.level}</strong>
        <p>{game.shortText}</p>
        <button type="button" class="vr-card-action" aria-label={`Обрати ${game.title}`}>Select</button>
      </article>
    ))}
  </div>
</Section>
