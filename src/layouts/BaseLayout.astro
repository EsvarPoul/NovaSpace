---
import "../styles/globals.css";
import { address, geo, phone } from "../data/seo.js";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  favicon?: "home" | "vr" | "studio";
  robots?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const faviconSets = {
  home: {
    ico: "/favicon.ico",
    png48: "/favicon-48x48.png",
    png192: "/favicon-192x192.png",
    svg: "/favicon.svg",
    apple: "/apple-touch-icon.png"
  },
  vr: {
    ico: "/favicon-vr.ico",
    png48: "/favicon-vr-48x48.png",
    png192: "/favicon-vr-192x192.png",
    svg: "/favicon-vr.svg",
    apple: "/apple-touch-icon-vr.png"
  },
  studio: {
    ico: "/favicon-studio.ico",
    png48: "/favicon-studio-48x48.png",
    png192: "/favicon-studio-192x192.png",
    svg: "/favicon-studio.svg",
    apple: "/apple-touch-icon-studio.png"
  }
};

const {
  title,
  description,
  canonicalPath,
  image = "/vr/nova-space-logo.webp",
  imageAlt,
  favicon = "home",
  robots = "index,follow",
  schema
} = Astro.props;

const selectedFavicon = faviconSets[favicon] ?? faviconSets.home;
const site = Astro.site ?? new URL("https://nova-space.pp.ua");
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
const socialImageAlt = imageAlt || title;
const schemaJson = schema ? JSON.stringify(schema).replace(/</g, "\\u003c") : "";
const shouldLoadGoogleAds = !robots.toLowerCase().includes("noindex");
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="uk-UA" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="icon" href={selectedFavicon.ico} sizes="any" />
    <link rel="icon" href={selectedFavicon.png48} type="image/png" sizes="48x48" />
    <link rel="icon" href={selectedFavicon.png192} type="image/png" sizes="192x192" />
    <link rel="icon" href={selectedFavicon.svg} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={selectedFavicon.apple} sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="theme-color" content="#050711" />
    <meta name="geo.region" content="UA-32" />
    <meta name="geo.placename" content={address.addressLocality} />
    <meta name="geo.position" content={`${geo.latitude};${geo.longitude}`} />
    <meta name="ICBM" content={`${geo.latitude}, ${geo.longitude}`} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nova Space" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="place:location:latitude" content={String(geo.latitude)} />
    <meta property="place:location:longitude" content={String(geo.longitude)} />
    <meta property="business:contact_data:street_address" content={address.streetAddress} />
    <meta property="business:contact_data:locality" content={address.addressLocality} />
    <meta property="business:contact_data:region" content={address.addressRegion} />
    <meta property="business:contact_data:postal_code" content={address.postalCode} />
    <meta property="business:contact_data:country_name" content="Ukraine" />
    <meta property="business:contact_data:phone_number" content={phone} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet" />
    {shouldLoadGoogleAds && <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18188518715"></script>}
    {shouldLoadGoogleAds && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag("js", new Date());

        gtag("config", "AW-18188518715");
      </script>
    )}
    {shouldLoadGoogleAds && (
      <script is:inline>
        (() => {
          const conversionLabels = {
            click_phone: "AW-18188518715/UQDSCOW7j8McELuK--BD",
            click_booking: "AW-18188518715/AcDdCOi7j8McELuK--BD",
            submit_form: "AW-18188518715/l25FCPSricMcELuK--BD"
          };

          const trackConversion = (actionName, eventParams = {}, callback) => {
            const sendTo = conversionLabels[actionName];
            if (!sendTo) return;
            let callbackComplete = false;
            const runCallback = () => {
              if (callbackComplete) return;
              callbackComplete = true;
              callback?.();
            };

            const payload = {
              send_to: sendTo,
              event_category: "lead",
              event_label: actionName,
              page_location: window.location.href,
              page_path: window.location.pathname,
              ...eventParams
            };

            if (callback) {
              payload.event_callback = runCallback;
              payload.event_timeout = 800;
            }

            if (typeof window.gtag === "function") {
              window.gtag("event", "conversion", payload);
              if (callback) window.setTimeout(runCallback, 900);
              return;
            }

            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push(["event", "conversion", payload]);
            if (callback) window.setTimeout(runCallback, 0);
          };

          window.novaTrackAdsConversion = trackConversion;

          document.addEventListener("click", (event) => {
            const target = event.target instanceof Element ? event.target : event.target?.parentElement;
            const link = target?.closest?.("a[href]");
            if (!link) return;

            const href = link.getAttribute("href") || "";
            const shouldDelayNavigation = event instanceof MouseEvent
              && event.button === 0
              && !event.defaultPrevented
              && !event.metaKey
              && !event.ctrlKey
              && !event.shiftKey
              && !event.altKey
              && !link.target
              && !link.hasAttribute("download");

            if (href.startsWith("tel:")) {
              if (shouldDelayNavigation) {
                event.preventDefault();
                trackConversion("click_phone", {
                  link_url: href
                }, () => {
                  window.location.href = href;
                });
                return;
              }

              trackConversion("click_phone", { link_url: href });
              return;
            }

            let url;
            try {
              url = new URL(href, window.location.href);
            } catch {
              return;
            }

            if (url.pathname === "/booking/" || url.pathname === "/booking" || url.hash === "#booking") {
              const eventParams = {
                link_url: url.href,
                service: url.searchParams.get("service") || ""
              };

              if (shouldDelayNavigation) {
                event.preventDefault();
                trackConversion("click_booking", eventParams, () => {
                  window.location.href = url.href;
                });
                return;
              }

              trackConversion("click_booking", eventParams);
            }
          }, true);
        })();
      </script>
    )}
    {schemaJson && <script is:inline type="application/ld+json" set:html={schemaJson}></script>}
  </head>
  <body>
    <slot />
  </body>
</html>
